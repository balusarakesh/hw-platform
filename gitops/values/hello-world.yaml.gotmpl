region: {{ fetchSecretValue "ref+awsssm://hw/gitops/region" | quote }}

image:
  repository: {{ fetchSecretValue "ref+awsssm://hw/gitops/ecr_repository_url" | quote }}

serviceAccount:
  roleArn: {{ fetchSecretValue "ref+awsssm://hw/gitops/role_hello_world" | quote }}

db:
  host: {{ fetchSecretValue "ref+awsssm://hw/gitops/db_host" | quote }}
  port: {{ fetchSecretValue "ref+awsssm://hw/gitops/db_port" | quote }}
  name: {{ fetchSecretValue "ref+awsssm://hw/gitops/db_name" | quote }}
  user: {{ fetchSecretValue "ref+awsssm://hw/gitops/db_app_user" | quote }}

dbBootstrap:
  roleArn: {{ fetchSecretValue "ref+awsssm://hw/gitops/role_db_bootstrap" | quote }}
  masterUsername: {{ fetchSecretValue "ref+awsssm://hw/gitops/db_master_username" | quote }}
  masterSecretArn: {{ fetchSecretValue "ref+awsssm://hw/gitops/db_master_secret_arn" | quote }}

ingress:
  host: app.{{ fetchSecretValue "ref+awsssm://hw/gitops/domain" }}
  certificateArn: {{ fetchSecretValue "ref+awsssm://hw/gitops/acm_certificate_arn" | quote }}
